{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vauchi.app/schemas/themes.schema.json",
  "title": "Themes",
  "description": "Theme definitions for Vauchi. Hierarchical primitives + semantic format (v2).",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id", "name", "version", "mode", "primitives", "semantic"],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*$",
        "description": "Unique lowercase identifier"
      },
      "name": {
        "type": "string",
        "minLength": 1,
        "description": "Human-readable display name"
      },
      "version": {
        "type": "string",
        "description": "Theme version"
      },
      "author": {
        "type": "string",
        "description": "Theme author"
      },
      "license": {
        "type": "string",
        "description": "Theme license"
      },
      "source": {
        "type": "string",
        "format": "uri",
        "description": "URL to original theme source"
      },
      "mode": {
        "type": "string",
        "enum": ["dark", "light"],
        "description": "Theme mode"
      },
      "primitives": {
        "type": "object",
        "description": "Palette-specific color primitives (hex values)",
        "minProperties": 1,
        "additionalProperties": { "$ref": "#/$defs/hexColor" }
      },
      "semantic": {
        "type": "object",
        "description": "Semantic color roles referencing primitives via {name}",
        "required": [
          "bg-primary",
          "bg-secondary",
          "bg-tertiary",
          "text-primary",
          "text-secondary",
          "accent",
          "accent-dark",
          "success",
          "error",
          "warning",
          "border"
        ],
        "properties": {
          "bg-primary": { "$ref": "#/$defs/colorRef" },
          "bg-secondary": { "$ref": "#/$defs/colorRef" },
          "bg-tertiary": { "$ref": "#/$defs/colorRef" },
          "text-primary": { "$ref": "#/$defs/colorRef" },
          "text-secondary": { "$ref": "#/$defs/colorRef" },
          "accent": { "$ref": "#/$defs/colorRef" },
          "accent-dark": { "$ref": "#/$defs/colorRef" },
          "success": { "$ref": "#/$defs/colorRef" },
          "error": { "$ref": "#/$defs/colorRef" },
          "warning": { "$ref": "#/$defs/colorRef" },
          "border": { "$ref": "#/$defs/colorRef" }
        },
        "additionalProperties": { "$ref": "#/$defs/colorRef" }
      }
    },
    "additionalProperties": false
  },
  "$defs": {
    "hexColor": {
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$",
      "description": "Hex color code (#rrggbb, or #rrggbbaa for alpha tokens like scrim — ADR-038 Amendment 1)"
    },
    "colorRef": {
      "type": "string",
      "pattern": "^\\{[a-zA-Z][a-zA-Z0-9-]*\\}$",
      "description": "Reference to a primitive color via {name}"
    }
  }
}
