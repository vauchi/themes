  {
    "id": "default-dark",
    "name": "Vauchi Dark",
    "version": "2.0.0",
    "author": "Vauchi",
    "license": "MIT",
    "mode": "dark",
    "primitives": {
      "base": "#1a1a2e",
      "surface": "#16213e",
      "overlay": "#0f3460",
      "text": "#eeeeee",
      "subtext": "#a0a0a0",
      "blue": "#4fc3f7",
      "sapphire": "#0288d1",
      "green": "#4caf50",
      "red": "#f44336",
      "peach": "#ff9800",
      "border-gray": "#333333"
    },
    "semantic": {
      "bg-primary": "{base}",
      "bg-secondary": "{surface}",
      "bg-tertiary": "{overlay}",
      "text-primary": "{text}",
      "text-secondary": "{subtext}",
      "accent": "{blue}",
      "accent-dark": "{sapphire}",
      "success": "{green}",
      "error": "{red}",
      "warning": "{peach}",
      "border": "{border-gray}"
    }
  },
